# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- MySQL (used by docker-compose and by the backend's DB_URL below) ---
MYSQL_DATABASE=password_leak_detector
MYSQL_USER=app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Backend: database connection ---
# When running via docker-compose, host is the "mysql" service name, not localhost.
DB_URL=jdbc:mysql://localhost:3306/password_leak_detector
DB_USERNAME=app
DB_PASSWORD=change-me

# --- Backend: JWT signing secret ---
# Must be at least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# --- Backend: AES-256 key for encrypting saved password-history values at rest ---
# Must be base64 and decode to exactly 32 bytes. Generate with: openssl rand -base64 32
AES_KEY=replace-with-a-base64-encoded-32-byte-key

# --- Backend: token lifetimes (optional, these are the defaults) ---
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Backend: refresh-token cookie "Secure" flag ---
# MUST be true when served over HTTPS. Left false for local docker-compose, which
# serves plain HTTP on localhost with no TLS termination in scope.
COOKIE_SECURE=false

# --- Backend: HIBP Pwned Passwords range API (no API key required) ---
HIBP_BASE_URL=https://api.pwnedpasswords.com/range/
HIBP_CONNECT_TIMEOUT_MS=3000
HIBP_READ_TIMEOUT_MS=5000
